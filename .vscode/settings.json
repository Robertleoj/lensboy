{
  "clangd.arguments": [
    "--compile-commands-dir=build",
    "--function-arg-placeholders=false",
    "--tweaks=-Wall",
    "--tweaks=-Wextra",
    "--clang-tidy",
    "--query-driver=/usr/bin/c++,/usr/bin/g++,/usr/bin/g++-*,/usr/bin/x86_64-linux-gnu-g++*",
    "-j=5"
  ],
  "search.useIgnoreFiles": false,
  "files.associations": {
    "*.py": "python",
    "*.rmd": "markdown",
    "ostream": "cpp",
    "vector": "cpp",
    "*.ipp": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
